# SMTP server authentication. Use an app password or provider-issued SMTP credential.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=alerts@example.com
SMTP_TO=operator@example.com

# A condition must persist for two minutes before the first alarm.
ALARM_AFTER_SECONDS=120
REMINDER_SECONDS=3600
STALE_CANDLES=3
DIVERGENCE_CANDLES=2
ERROR_WINDOW_MINUTES=10
REPEATED_ERRORS=2
